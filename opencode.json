{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "apiKey": "{env:LLAMA_SERVER_API_KEY}",
        "baseURL": "{env:LLAMA_SERVER_URL}"
      },
      "body": {
        "cache_prompt": true
      },
      "models": {
        "{env:LLAMA_MODEL}/plan": {
          "id": "{env:LLAMA_MODEL}",
          "constraints": {
            "jsonMode": true
          },
          "parameters": {
            "stop": ["<|im_end|>", "<|object_ref_start|>", "</tool_call>"],
            "temperature": 0.1
          },
          "headers": {
            "X-LLamaCPP-Id-slot": "6"
          }
        },
        "{env:LLAMA_MODEL}/build": {
          "id": "{env:LLAMA_MODEL}",
          "constraints": {
            "jsonMode": true
          },
          "parameters": {
            "stop": ["<|im_end|>", "<|object_ref_start|>", "</tool_call>"],
            "temperature": 0.1
          },
          "headers": {
            "X-LLamaCPP-Id-slot": "5"
          }
        },
        "{env:LLAMA_MODEL}/explore1": {
          "id": "{env:LLAMA_MODEL}",
          "constraints": {
            "jsonMode": true
          },
          "parameters": {
            "stop": ["<|im_end|>", "<|object_ref_start|>", "</tool_call>"],
            "temperature": 0.0
          },
          "headers": {
            "X-LLamaCPP-Id-slot": "4"
          }
        },
        "{env:LLAMA_MODEL}/explore2": {
          "id": "{env:LLAMA_MODEL}",
          "constraints": {
            "jsonMode": true
          },
          "parameters": {
            "stop": ["<|im_end|>", "<|object_ref_start|>", "</tool_call>"],
            "temperature": 0.0
          },
          "headers": {
            "X-LLamaCPP-Id-slot": "2"
          }
        },
        "{env:LLAMA_MODEL}/verifier": {
          "id": "{env:LLAMA_MODEL}",
          "constraints": {
            "jsonMode": true
          },
          "parameters": {
            "stop": ["<|im_end|>", "<|object_ref_start|>", "</tool_call>"],
            "temperature": 0.0
          },
          "headers": {
            "X-LLamaCPP-Id-slot": "3"
          }
        }
      }
    }
  },
  "model": "llama.cpp/{env:LLAMA_MODEL}/build",
  "permission": {
    "edit": "allow",
    "bash": "allow"
  },
  "plugin": [
    "opencode-working-memory",
    "opencode-plugin-openspec",
    "opencode-ralph-loop",
    "opencode-mem"
  ],
  "compaction": {
    "enabled": true,
    "auto": true,
    "threshold": 0.90,
    "strategy": "summarize",
    "preserveRecentMessages": 6,
    "preserveSystemPrompt": true
  },
  "agent": {
    "primary": {
      "default": "build"
    },
    "plan": {
      "mode": "primary",
      "provider": "llama.cpp",
      "model": "llama.cpp/{env:LLAMA_MODEL}/plan"
    },
    "build": {
      "mode": "primary",
      "provider": "llama.cpp",
      "model": "llama.cpp/{env:LLAMA_MODEL}/build"
    },
    "explore1": {
      "mode": "subagent",
      "description": "Primary read-only codebase explorer for pattern matching, grep, and file inspection.",
      "provider": "llama.cpp",
      "model": "llama.cpp/{env:LLAMA_MODEL}/explore1"
    },
    "explore2": {
      "mode": "subagent",
      "description": "Secondary read-only codebase explorer for parallel search, file inspection, and dependency tracing.",
      "provider": "llama.cpp",
      "model": "llama.cpp/{env:LLAMA_MODEL}/explore2"
    },
    "verifier": {
      "mode": "subagent",
      "description": "Runs test suites, typecheckers, and linters via bash commands to verify correctness.",
      "provider": "llama.cpp",
      "model": "llama.cpp/{env:LLAMA_MODEL}/verifier"
    },
    "default": {
      "max_concurrency": 2,
      "force_sequential_tasks": false,
      "allowed_subagents": ["explore1", "explore2", "verifier"]
    }
  },
  "mcp": {
    "ccc-granular": {
      "type": "local",
      "enabled": true,
      "command": ["python3", "/mcp/ccc_granular/server.py"]
    },
    "cocoindex-code": {
      "type": "local",
      "enabled": true,
      "command": ["ccc", "mcp"]
    },
    "llama-slot-cache": {
      "type": "local",
      "enabled": true,
      "command": ["python3", "/mcp/llama-slot-cache/server.py"]
    }
  }
}
